---
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const img = (name: string) => `${base}/capturas-1595/${name}.webp`;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>#1595 · Auditoria UI/UX e Comparação Antes × Propostas · Dimension Riders</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <style>
      :root {
        color-scheme: light;
        --bg: #f6f5f2;
        --sheet: #ffffff;
        --surface: #f0ede6;
        --text: #18181b;
        --secondary: #3f3f46;
        --muted: #71717a;
        --border: #e2ded5;
        --border-strong: #c7c1b4;
        --accent: #b45309;
        --danger-bg: #fef2f2;
        --danger-border: #fecaca;
        --danger-text: #991b1b;
        --ok-bg: #f0fdf4;
        --ok-border: #bbf7d0;
        --ok-text: #166534;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--text);
        font-size: 15px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      img { max-width: 100%; height: auto; display: block; }
      a { color: inherit; }
      code { overflow-wrap: anywhere; }
      .wrap { width: min(1360px, calc(100% - 32px)); margin: 0 auto; }

      .top-bar {
        position: sticky;
        top: 0;
        z-index: 30;
        background: rgba(246, 245, 242, 0.94);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
        padding: 10px 0;
      }
      .top-bar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 10px 16px;
      }
      .top-title {
        font-weight: 700;
        font-size: 14px;
      }
      .top-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .top-nav a {
        text-decoration: none;
        font-size: 13px;
        font-weight: 500;
        padding: 6px 10px;
        border-radius: 6px;
        background: var(--sheet);
        border: 1px solid var(--border);
      }
      .top-nav a.primary {
        background: #18181b;
        color: #ffffff;
        border-color: #18181b;
      }

      .hero-box {
        background: var(--sheet);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 28px;
        margin: 24px 0;
      }
      .hero-box h1 {
        font-size: clamp(22px, 3vw, 30px);
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin: 0 0 10px;
      }
      .hero-box p {
        margin: 0 0 16px;
        color: var(--secondary);
        max-width: 880px;
      }
      .proto-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-top: 20px;
      }
      .proto-card {
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 18px;
        background: var(--bg);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      .proto-card.rec {
        border: 2px solid #18181b;
        background: #ffffff;
      }
      .proto-badge {
        display: inline-block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 2px 7px;
        border-radius: 4px;
        background: var(--surface);
        margin-bottom: 8px;
        align-self: flex-start;
      }
      .proto-card.rec .proto-badge {
        background: #18181b;
        color: #ffffff;
      }
      .proto-card h2 {
        font-size: 17px;
        margin: 0 0 6px;
      }
      .proto-card p {
        font-size: 13.5px;
        margin: 0 0 14px;
        color: var(--secondary);
      }
      .proto-links {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }
      .proto-links a {
        text-decoration: none;
        font-size: 12.5px;
        font-weight: 600;
        padding: 7px 11px;
        border-radius: 6px;
        border: 1px solid var(--border-strong);
        background: var(--sheet);
      }
      .proto-links a.open-main {
        background: #18181b;
        color: #ffffff;
        border-color: #18181b;
      }

      .comp-section {
        background: var(--sheet);
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 24px;
      }
      .comp-head {
        border-bottom: 1px solid var(--border);
        padding-bottom: 14px;
        margin-bottom: 20px;
      }
      .comp-head h2 {
        font-size: 20px;
        margin: 0 0 4px;
        letter-spacing: -0.01em;
      }
      .comp-head p {
        margin: 0;
        font-size: 14px;
        color: var(--secondary);
      }

      .grid-4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        align-items: start;
      }
      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        align-items: start;
      }
      .shot-col {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 8px;
        overflow: hidden;
      }
      .shot-col.before {
        border-color: var(--danger-border);
      }
      .shot-col.after {
        border-color: var(--ok-border);
      }
      .shot-col-head {
        padding: 10px 12px;
        border-bottom: 1px solid var(--border);
        font-size: 13px;
      }
      .shot-col.before .shot-col-head {
        background: var(--danger-bg);
        color: var(--danger-text);
      }
      .shot-col.after .shot-col-head {
        background: var(--ok-bg);
        color: var(--ok-text);
      }
      .shot-col-head strong {
        display: block;
        font-size: 13.5px;
      }
      .shot-col-head span {
        display: block;
        font-size: 12px;
        opacity: 0.9;
        margin-top: 2px;
      }
      .shot-col a.zoom {
        display: block;
      }
      .shot-col img {
        width: 100%;
        display: block;
      }

      .audit-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
      }
      .audit-table th,
      .audit-table td {
        text-align: left;
        padding: 10px 12px;
        border-bottom: 1px solid var(--border);
        vertical-align: top;
      }
      .audit-table th {
        background: var(--bg);
        font-size: 12px;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        text-transform: uppercase;
      }
      .tag-p1 {
        display: inline-block;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 4px;
        background: #fef3c7;
        color: #92400e;
      }

      @media (max-width: 960px) {
        .proto-cards,
        .grid-3 {
          grid-template-columns: 1fr;
        }
        .grid-4 {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 600px) {
        .wrap { width: calc(100% - 20px); }
        .top-bar { position: static; }
        .hero-box, .comp-section { padding: 16px; }
        .grid-4 { gap: 8px; }
        .shot-col-head { padding: 8px; font-size: 11.5px; }
        .shot-col-head strong { font-size: 12px; }
        .shot-col-head span { font-size: 11px; }
        .audit-table { display: block; overflow-x: auto; max-width: 100%; }
      }
    </style>
  </head>
  <body>
    <header class="top-bar">
      <div class="wrap top-bar-inner">
        <span class="top-title">#1595 · Auditoria UI/UX & Comparação Antes × Propostas</span>
        <nav class="top-nav" aria-label="Atalhos da comparação">
          <a href="#celular-dobra">1. Celular (1ª Dobra)</a>
          <a href="#bug-baixar">2. Bug /baixar</a>
          <a href="#celular-completa">3. Celular (Inteira)</a>
          <a href="#desktop-completa">4. Desktop (1440px)</a>
          <a href="#suporte-doc">5. Suporte / Docs</a>
          <a href="#melhorias">6. Melhorias & Refs</a>
          <a class="primary" href={`${base}/proposta/a/`}>Abrir Protótipo A →</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <section class="hero-box">
        <h1>Rodada 2 (#1595) — Três arquiteturas humanas distintas (zero bento-grid / template SaaS de IA)</h1>
        <p>
          Na primeira tentativa, as opções A, B e C ainda pareciam site gerado por IA porque compartilhavam o <strong>mesmo esqueleto de landing page SaaS/Tailwind</strong> (rótulos numerados <code>01 / GAMEPLAY</code>, caixinhas arredondadas em grade <code>repeat(3, 1fr)</code>, pílulas <code>CAMADA I</code> e tabela 2×2 no topo).{' '}
          Agora cada opção tem uma <strong>arquitetura de página própria</strong>, inspirada em sites reais de jogos independentes (<em>Firewatch / Supergiant</em>, <em>Untitled Goose Game / manuais impressos</em> e <em>Apple Arcade / vitrines mobile</em>), já com o pacote <strong>P1.1 a P1.8</strong> aprovado.
        </p>

        <div class="proto-cards">
          <article class="proto-card rec">
            <div>
              <span class="proto-badge">Opção A · Pôster & Palco</span>
              <h2>A · Pôster Cinematográfico (Firewatch / Supergiant)</h2>
              <p>
                <strong>Zero cards e zero caixas.</strong> A pintura <code>hero.webp</code> abre em tela cheia como pôster (fundo carvão quente <code>#11100E</code>); abaixo, as 4 telas reais <code>9:16</code> aparecem soltas em degraus assimétricos, seguidas de prosa editorial ao lado de <code>duel.webp</code> e de um panorama contínuo de 5 fatias das camadas.
              </p>
            </div>
            <div class="proto-links">
              <a class="open-main" href={`${base}/proposta/a/`}>Abrir Início A</a>
              <a href={`${base}/proposta/a/baixar/`}>Baixar A</a>
              <a href={`${base}/proposta/a/suporte/`}>Suporte A</a>
              <a href={`${base}/proposta/a/en/`}>EN</a>
            </div>
          </article>

          <article class="proto-card">
            <div>
              <span class="proto-badge">Opção B · Papel & Nanquim</span>
              <h2>B · Almanaque Impresso de Papel Dobrado</h2>
              <p>
                Desenhado como um <strong>almanaque impresso de RPG</strong> sobre papel creme (<code>#F2ECE1</code>) e faixa kraft (<code>#E5DCC8</code>), cantos vivos (<code>0px</code>), fios de nanquim (<code>#191714</code>), corpo em serifa <code>Georgia</code> com capitular vermelha, gravuras coladas (<em>Estampa I</em> + <em>Fig. 1 a 4</em>) e as 5 camadas num índice horizontal de livro.
              </p>
            </div>
            <div class="proto-links">
              <a class="open-main" href={`${base}/proposta/b/`}>Abrir Início B</a>
              <a href={`${base}/proposta/b/baixar/`}>Baixar B</a>
              <a href={`${base}/proposta/b/suporte/`}>Suporte B</a>
              <a href={`${base}/proposta/b/en/`}>EN</a>
            </div>
          </article>

          <article class="proto-card">
            <div>
              <span class="proto-badge">Opção C · Gameplay na 1ª Tela</span>
              <h2>C · Vitrine Direta de Jogo Mobile</h2>
              <p>
                Pensada para quem abre no celular e quer ver o jogo em 1 segundo: capa panorâmica + <strong>doca de ícone (88px), título e botão Baixar</strong>, seguida <strong>imediatamente em <code>y = 385px</code> pelas 4 capturas reais <code>9:16</code></strong> (sem texto de marketing antes do jogo!), tira de camadas em banner e barra fixa inferior no celular.
              </p>
            </div>
            <div class="proto-links">
              <a class="open-main" href={`${base}/proposta/c/`}>Abrir Início C</a>
              <a href={`${base}/proposta/c/baixar/`}>Baixar C</a>
              <a href={`${base}/proposta/c/suporte/`}>Suporte C</a>
              <a href={`${base}/proposta/c/en/`}>EN</a>
            </div>
          </article>
        </div>
      </section>

      <!-- 1. CELULAR 1ª DOBRA -->
      <section class="comp-section" id="celular-dobra">
        <div class="comp-head">
          <h2>1. Celular (390×844 px) — Primeira Dobra (O que o visitante vê ao abrir)</h2>
          <p>
            Capturas reais na mesma largura (390 px, 2x DPR). Toque em qualquer imagem para ampliar. Repare como as três opções têm estrutura, tipografia e personalidade completamente diferentes entre si.
          </p>
        </div>
        <div class="grid-4">
          <div class="shot-col before">
            <div class="shot-col-head">
              <strong>ANTES (Atual no ar)</strong>
              <span>Cabeçalho de 125px (2 linhas), botão plástico 3D e zero captura do jogo até y=2221px.</span>
            </div>
            <a class="zoom" href={img('fold-mobile-pt-home')}>
              <img src={img('fold-mobile-pt-home')} alt="Antes: Início celular primeira dobra" loading="eager" />
            </a>
          </div>
          <div class="shot-col after">
            <div class="shot-col-head">
              <strong>OPÇÃO A (Pôster Cinematográfico)</strong>
              <span>Pintura em tela cheia, fundo carvão #11100E e topo das capturas reais já visível na 1ª tela.</span>
            </div>
            <a class="zoom" href={img('fold-mobile-a-pt-home')}>
              <img src={img('fold-mobile-a-pt-home')} alt="Proposta A: Início celular primeira dobra" loading="eager" />
            </a>
          </div>
          <div class="shot-col after">
            <div class="shot-col-head">
              <strong>OPÇÃO B (Almanaque Impresso)</strong>
              <span>Papel creme #F2ECE1, capitular em serifa, botão nanquim e prancha dupla (Estampa I + Fig. 1).</span>
            </div>
            <a class="zoom" href={img('fold-mobile-b-pt-home')}>
              <img src={img('fold-mobile-b-pt-home')} alt="Proposta B: Início celular primeira dobra" loading="eager" />
            </a>
          </div>
          <div class="shot-col after">
            <div class="shot-col-head">
              <strong>OPÇÃO C (Vitrine Mobile Direta)</strong>
              <span>Ícone + título + CTA e duas capturas reais grandes já ocupando metade da 1ª tela (y=385px).</span>
            </div>
            <a class="zoom" href={img('fold-mobile-c-pt-home')}>
              <img src={img('fold-mobile-c-pt-home')} alt="Proposta C: Início celular primeira dobra" loading="eager" />
            </a>
          </div>
        </div>
      </section>

      <!-- 2. BUG DA PÁGINA BAIXAR -->
      <section class="comp-section" id="bug-baixar">
        <div class="comp-head">
          <h2>2. Página Baixar (/pt/baixar/) — Correção do Logo Cortado ("ENSION / ERS") e Duplicações</h2>
          <p>
            No site atual, <code>Download.astro</code> recorta <code>feature.webp</code> com <code>aspect-ratio: 1.35; object-position: 78% center</code>, decepando o logo em <strong>"ENSION / ERS"</strong> e o Cavaleiro ao meio, além de repetir "EM BREVE" duas vezes na mesma caixa. As propostas usam <code>duel.webp</code> (a pintura limpa sem o texto duplicado) e alinham o ícone ao lado do título.
          </p>
        </div>
        <div class="grid-3">
          <div class="shot-col before">
            <div class="shot-col-head">
              <strong>ANTES — /pt/baixar/ (Desktop 1440px)</strong>
              <span>Logo cortado ("ENSION / ERS"), ícone tapando o Cavaleiro e "EM BREVE" duplicado.</span>
            </div>
            <a class="zoom" href={img('full-desktop-pt-baixar')}>
              <img src={img('full-desktop-pt-baixar')} alt="Antes: Baixar desktop" loading="lazy" />
            </a>
          </div>
          <div class="shot-col after">
            <div class="shot-col-head">
              <strong>OPÇÃO A — /pt/baixar/ (Pôster)</strong>
              <span>Pintura duel.webp inteira sobre carvão quente #11100E e ficha em linhas simples.</span>
            </div>
            <a class="zoom" href={img('full-desktop-a-pt-baixar')}>
              <img src={img('full-desktop-a-pt-baixar')} alt="Proposta A: Baixar desktop" loading="lazy" />
            </a>
          </div>
          <div class="shot-col after">
            <div class="shot-col-head">
              <strong>OPÇÃO B — /pt/baixar/ (Almanaque)</strong>
              <span>Prancha impressa em papel com moldura de nanquim e tipografia editorial.</span>
            </div>
            <a class="zoom" href={img('full-desktop-b-pt-baixar')}>
              <img src={img('full-desktop-b-pt-baixar')} alt="Proposta B: Baixar desktop" loading="lazy" />
            </a>
          </div>
        </div>
      </section>

      <!-- 3. CELULAR PÁGINA INTEIRA -->
      <section class="comp-section" id="celular-completa">
        <div class="comp-head">
          <h2>3. Celular (390 px) — Página Inicial Completa (Antes × A × B × C)</h2>
          <p>
            Veja a página inteira em 390 px: zero caixas esmagadas de 118px, zero esquilo em T-pose em fundo cinza e três arquiteturas reais de página.
          </p>
        </div>
        <div class="grid-4">
          <div class="shot-col before">
            <div class="shot-col-head">
              <strong>ANTES (390 px completa)</strong>
              <span>3 colunas esmagadas + T-pose cinza antes das capturas minúsculas em 2×2.</span>
            </div>
            <a class="zoom" href={img('full-mobile-pt-home')}>
              <img src={img('full-mobile-pt-home')} alt="Antes: Início celular completa" loading="lazy" />
            </a>
          </div>
          <div class="shot-col after">
            <div class="shot-col-head">
              <strong>OPÇÃO A (Pôster Cinematográfico)</strong>
              <span>Telas soltas sem caixa, prosa com duel.webp e panorama das 5 camadas.</span>
            </div>
            <a class="zoom" href={img('full-mobile-a-pt-home')}>
              <img src={img('full-mobile-a-pt-home')} alt="Proposta A: Início celular completa" loading="lazy" />
            </a>
          </div>
          <div class="shot-col after">
            <div class="shot-col-head">
              <strong>OPÇÃO B (Almanaque Impresso)</strong>
              <span>Faixa kraft com Fig. 1–4, 3 colunas de jornal e índice de livro das 5 camadas.</span>
            </div>
            <a class="zoom" href={img('full-mobile-b-pt-home')}>
              <img src={img('full-mobile-b-pt-home')} alt="Proposta B: Início celular completa" loading="lazy" />
            </a>
          </div>
          <div class="shot-col after">
            <div class="shot-col-head">
              <strong>OPÇÃO C (Vitrine Mobile Direta)</strong>
              <span>Capturas reais logo abaixo do ícone do jogo + banners horizontais das 5 camadas.</span>
            </div>
            <a class="zoom" href={img('full-mobile-c-pt-home')}>
              <img src={img('full-mobile-c-pt-home')} alt="Proposta C: Início celular completa" loading="lazy" />
            </a>
          </div>
        </div>
      </section>

      <!-- 4. DESKTOP PÁGINA INTEIRA -->
      <section class="comp-section" id="desktop-completa">
        <div class="comp-head">
          <h2>4. Desktop (1440 px) — Página Inicial Completa (Antes × A × B × C)</h2>
          <p>
            Comparação em 1440 px de largura: veja como cada opção organiza o palco principal, as 4 capturas verticais e as 5 camadas de um jeito único.
          </p>
        </div>
        <div class="grid-4">
          <div class="shot-col before">
            <div class="shot-col-head">
              <strong>ANTES (1440 px)</strong>
              <span>Fundo roxo #0b0820, bordas marrons e conceitos em fundo cinza.</span>
            </div>
            <a class="zoom" href={img('full-desktop-pt-home')}>
              <img src={img('full-desktop-pt-home')} alt="Antes: Início desktop completa" loading="lazy" />
            </a>
          </div>
          <div class="shot-col after">
            <div class="shot-col-head">
              <strong>OPÇÃO A (Pôster · 1440 px)</strong>
              <span>Pintura full-bleed, 4 telas em degraus assimétricos e horizonte contínuo de 5 fatias.</span>
            </div>
            <a class="zoom" href={img('full-desktop-a-pt-home')}>
              <img src={img('full-desktop-a-pt-home')} alt="Proposta A: Início desktop completa" loading="lazy" />
            </a>
          </div>
          <div class="shot-col after">
            <div class="shot-col-head">
              <strong>OPÇÃO B (Almanaque · 1440 px)</strong>
              <span>Papel creme e faixa kraft, gravuras emolduradas em nanquim e tabela-razão das 5 camadas.</span>
            </div>
            <a class="zoom" href={img('full-desktop-b-pt-home')}>
              <img src={img('full-desktop-b-pt-home')} alt="Proposta B: Início desktop completa" loading="lazy" />
            </a>
          </div>
          <div class="shot-col after">
            <div class="shot-col-head">
              <strong>OPÇÃO C (Vitrine Mobile · 1440 px)</strong>
              <span>Capa + doca de app com as 4 telas reais imediatamente abaixo e pilha de banners das camadas.</span>
            </div>
            <a class="zoom" href={img('full-desktop-c-pt-home')}>
              <img src={img('full-desktop-c-pt-home')} alt="Proposta C: Início desktop completa" loading="lazy" />
            </a>
          </div>
        </div>
      </section>

      <!-- 5. SUPORTE E DOCUMENTOS -->
      <section class="comp-section" id="suporte-doc">
        <div class="comp-head">
          <h2>5. Páginas de Texto (Suporte, Privacidade e Termos) — Fim do Paredão em Rajdhani SemiBold</h2>
          <p>
