---
/** Direção A, "Travessia": pinturas de largura total, fundo escuro, capítulos alternando texto e figura. */
import { Image } from 'astro:assets';
import DownloadLink from '../components/DownloadLink.astro';
import { localePath, t } from '../i18n';
import Base from '../layouts/Base.astro';
import Paragraphs from '../components/Paragraphs.astro';
import type { FoldProps } from '../content/fold-chapters';
import riftIslands from '../images/fold/rift-islands.webp';
import threeRifts from '../images/fold/three-rifts.webp';
import riderRift from '../images/fold/rider-rift.webp';
import amber from '../images/fold/amber.webp';
import duel from '../images/fold/duel.webp';
import { WORLDS, TYRANTS } from '../images/fold';

type Props = FoldProps;
const { locale, opening, chapters } = Astro.props;
const roman = ['I', 'II', 'III', 'IV', 'V'];
const [worlds, amberCh, unfolded, riders, seal] = chapters;
const seal_ = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/selo.svg`;
---
<Base locale={locale} page="fold" title={t(locale, 'fold.title')}>
  <article class="fa">
    <header class="fa-hero">
      <Image class="fa-hero-art" src={riftIslands} alt={t(locale, 'fold.heroAlt')} widths={[800, 1200, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
      <div class="wrap fa-hero-copy">
        <p class="eyebrow">{t(locale, 'fold.eyebrow')}</p>
        <h1>{t(locale, 'fold.title')}</h1>
        <div class="fa-lede"><Paragraphs items={opening} /></div>
        <nav class="fa-index" aria-label={t(locale, 'fold.indexLabel')}>
          {chapters.map((c, i) => <a href={`#${c.id}`}><span aria-hidden="true">{roman[i]}</span>{c.title}</a>)}
        </nav>
      </div>
    </header>

    <section class="fa-chapter" id={worlds.id} data-chapter="1">
      <div class="wrap">
        <div class="fa-grid">
          <div class="fa-text">
            <p class="fa-kicker">{t(locale, 'fold.chapter', { n: roman[0] })}</p>
            <h2>{worlds.title}</h2>
            <Paragraphs items={worlds.paragraphs} />
          </div>
          <figure class="fa-figure">
            <Image src={threeRifts} alt={t(locale, 'fold.figures.threeRifts')} widths={[480, 760, 1100]} sizes="(max-width: 850px) 92vw, 560px" loading="lazy" />
            <figcaption>{t(locale, 'fold.figures.threeRiftsCaption')}</figcaption>
          </figure>
        </div>
        <div class="fa-worlds">
          <div class="fa-worlds-top"><h3>{t(locale, 'fold.worlds.label')}</h3><p>{t(locale, 'fold.worlds.note')}</p></div>
          <ul class="fa-world-list">
            {WORLDS.map(({ key, image }, i) => (
              <li class="fa-world">
                <Image src={image} alt={t(locale, `fold.worlds.${key}.alt`)} widths={[300, 450, 900]} sizes="(max-width: 600px) 72vw, 230px" loading="lazy" />
                <div>
                  <span class="layer">{t(locale, 'fold.worlds.layer', { n: String(i + 1) })}</span>
                  <h4>{t(locale, `fold.worlds.${key}.name`)}</h4>
                  <p>{t(locale, `fold.worlds.${key}.line`)}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="fa-chapter" id={amberCh.id} data-chapter="2">
      <div class="wrap fa-grid flip">
        <div class="fa-text">
          <p class="fa-kicker">{t(locale, 'fold.chapter', { n: roman[1] })}</p>
          <h2>{amberCh.title}</h2>
          <Paragraphs items={amberCh.paragraphs} />
        </div>
        <figure class="fa-figure">
          <div class="fa-medal"><Image src={amber} alt={t(locale, 'fold.figures.amber')} widths={[420, 800]} sizes="420px" loading="lazy" /></div>
          <figcaption>{t(locale, 'fold.figures.amberCaption')}</figcaption>
        </figure>
      </div>
    </section>

    <section class="fa-chapter" id={unfolded.id} data-chapter="3">
      <div class="wrap">
        <div class="fa-text wide">
          <p class="fa-kicker">{t(locale, 'fold.chapter', { n: roman[2] })}</p>
          <h2>{unfolded.title}</h2>
          <Paragraphs items={unfolded.paragraphs} />
        </div>
        <div class="fa-cast">
          <div class="fa-worlds-top"><h3>{t(locale, 'fold.cast.label')}</h3><p>{t(locale, 'fold.cast.note')}</p></div>
          <ul class="fa-cast-list">
            {TYRANTS.map(({ key, image }) => (
              <li>
                <Image src={image} alt={t(locale, `fold.cast.${key}.alt`)} widths={[180, 360]} sizes="180px" loading="lazy" />
                <h4>{t(locale, `fold.cast.${key}.name`)}</h4>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="fa-chapter fa-band" id={riders.id} data-chapter="4">
      <Image class="fa-band-art" src={riderRift} alt={t(locale, 'fold.figures.riderRift')} widths={[800, 1200, 1600]} sizes="100vw" loading="lazy" />
      <div class="wrap">
        <div class="fa-text">
          <p class="fa-kicker">{t(locale, 'fold.chapter', { n: roman[3] })}</p>
          <h2>{riders.title}</h2>
          <Paragraphs items={riders.paragraphs} motto />
        </div>
      </div>
    </section>

    <section class="fa-chapter" id={seal.id} data-chapter="5">
      <div class="wrap fa-grid flip">
        <div class="fa-text">
          <p class="fa-kicker">{t(locale, 'fold.chapter', { n: roman[4] })}</p>
          <h2>{seal.title}</h2>
          <Paragraphs items={seal.paragraphs} />
        </div>
        <figure class="fa-figure fa-seal">
          <div class="fa-seal-stone"><img src={seal_} width="135" height="155" alt={t(locale, 'fold.figures.seal')} loading="lazy" /></div>
          <figcaption>{t(locale, 'fold.figures.sealCaption')}</figcaption>
        </figure>
      </div>
    </section>

    <section class="fa-call">
      <Image class="fa-call-art" src={duel} alt="" widths={[640, 1024]} sizes="100vw" loading="lazy" />
      <h2>{t(locale, 'fold.cta.title')}</h2>
      <p>{t(locale, 'fold.cta.text')}</p>
      <DownloadLink locale={locale} />
      <p class="fa-home"><a class="text-link" href={localePath(locale, 'home')}>{t(locale, 'fold.cta.home')}</a></p>
    </section>
  </article>
</Base>
