---
import { loadDoc, type DocName } from '../content/load';
import { Image } from 'astro:assets';
import { shotsFor } from '../images/shots';
import { t, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';

interface Props { locale: Locale; page: DocName }
const { locale, page } = Astro.props;
const { Content } = loadDoc(page, locale);
---
<Base locale={locale} page={page} title={t(locale, `${page}.title`)}>
  <section class="doc-intro">
    <div class="wrap"><div class="eyebrow">{t(locale, 'site.name')}</div><h1>{t(locale, `${page}.title`)}</h1><p>{t(locale, `${page}.intro`)}</p></div>
  </section>
  <div class="reading">
    <article class="prose"><Content /></article>
    {page === 'fold' && <figure class="fold-shot">
      <Image src={shotsFor(locale).fold} alt={t(locale, 'fold.imageAlt')} widths={[320, 540, 760]} sizes="(max-width: 600px) 90vw, 360px" loading="lazy" />
      <figcaption>{t(locale, 'fold.imageCaption')}</figcaption>
    </figure>}
  </div>
</Base>
