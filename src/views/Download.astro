---
import StoreButtons from '../components/StoreButtons.astro';
import { PLAY_STORE_URL } from '../config';
import { t, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<Base locale={locale} page="download" title={t(locale, 'download.title')}>
  <article class="prose">
    <h1>{t(locale, 'download.title')}</h1>
    <p>{t(locale, 'download.intro')}</p>

    <h2>{t(locale, 'download.storeTitle')}</h2>
    <p>{PLAY_STORE_URL === '' ? t(locale, 'download.storeSoon') : t(locale, 'download.storeReady')}</p>

    <h2>{t(locale, 'download.apkTitle')}</h2>
    <StoreButtons locale={locale} />
    <p>{t(locale, 'download.requirements')}</p>
    <ol>
      <li>{t(locale, 'download.step1')}</li>
      <li>{t(locale, 'download.step2')}</li>
      <li>{t(locale, 'download.step3')}</li>
    </ol>
  </article>
</Base>
