---
import FeatureBlock from '../components/FeatureBlock.astro';
import Gallery from '../components/Gallery.astro';
import Hero from '../components/Hero.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { shots } from '../images/shots';
import { t, type Locale } from '../i18n';
import Base from '../layouts/Base.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const features = ['ride', 'seal', 'tyrants'] as const;
---
<Base locale={locale} page="home">
  <Hero locale={locale} />
  <section class="features">
    {features.map((key, i) => (
      <FeatureBlock title={t(locale, `features.${key}.title`)} text={t(locale, `features.${key}.text`)} image={shots[i]} />
    ))}
  </section>
  <Gallery locale={locale} />
  <section class="cta">
    <h2>{t(locale, 'cta.title')}</h2>
    <p>{t(locale, 'cta.text')}</p>
    <StoreButtons locale={locale} />
  </section>
</Base>
