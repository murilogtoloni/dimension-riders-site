---
import { Image, Picture } from 'astro:assets';
import { CONTACT_EMAIL } from '../config';
import { loadDoc } from '../content/load';
import { HTML_LANG, t, type Locale } from '../i18n';
import duel from '../images/fold/duel.webp';
import { TYRANTS, WORLDS } from '../images/fold';
import threeRifts from '../images/fold/three-rifts.webp';
import hero from '../images/hero.webp';
import icon from '../images/icon.webp';
import { shotsFor } from '../images/shots';
import '../styles/propostas-1595.css';

interface Props {
  dir: 'a' | 'b' | 'c';
  locale: Locale;
  view?: 'home' | 'download' | 'support';
}

const { dir, locale, view = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const seal = `${base}/selo.svg`;
const shots = shotsFor(locale);
const shotKeys = ['forest', 'gear', 'lava', 'arsenal'] as const;
const { Content: SupportContent } = loadDoc('support', locale);

const otherLocale: Locale = locale === 'pt' ? 'en' : 'pt';
const protoHref = (d: 'a' | 'b' | 'c', l: Locale = locale, v: 'home' | 'download' | 'support' = view) => {
  const langSeg = l === 'en' ? 'en/' : '';
  const viewSeg = v === 'home' ? '' : `${v === 'download' ? 'baixar' : 'suporte'}/`;
  return `${base}/proposta/${d}/${langSeg}${viewSeg}`;
};

const copy = locale === 'pt' ? {
  dirLabel: {
    a: 'Direção A · Noir Tático & Gameplay na Frente',
    b: 'Direção B · Editorial Papel Dobrado (#1594)',
    c: 'Direção C · Atlas Imersivo & Barra Fixa Mobile',
  }[dir],
  specs: [
    { label: 'Plataforma', val: 'Android 8.0+' },
    { label: 'Controle', val: '1 polegar (mover e atirar)' },
    { label: 'Conexão', val: 'Joga 100% offline' },
    { label: 'Modelo', val: 'Grátis · Sem anúncio forçado' },
  ],
  heroKicker: 'AÇÃO PARA ANDROID · UM POLEGAR · OFFLINE',
  shotsKicker: '01 · DIRETO DO APARELHO',
  shotsTitle: 'Veja a corrida antes de baixar.',
  shotsIntro: 'Capturas reais em 9:16 com a interface do jogo. Deslize para ver as camadas e o menu Equipar.',
  pillarsKicker: '02 · COMO FUNCIONA A CORRIDA',
  pillarsTitle: 'Três regras simples. Nenhuma distração.',
  pillarsIntro: 'Feito para partidas rápidas no celular, sem tutoriais intermináveis nem janelas de cobrança.',
  pillars: [
    {
      num: '01 / COMBATE',
      title: 'Mova para escapar. Pare para atirar.',
      text: 'Tudo em um polegar só: arraste pelo chão para desviar dos projéteis e solte para o Cavaleiro cravar os pés e disparar no alvo marcado.',
    },
    {
      num: '02 / ARSENAL',
      title: 'Cada corrida, uma combinação.',
      text: 'Troque entre arco, lâminas e cajados, vista armaduras das camadas e encaixe lascas do Selo como runas que mudam seu estilo.',
    },
    {
      num: '03 / PROGRESSO',
      title: 'No seu aparelho, no seu ritmo.',
      text: 'Funciona no avião ou no metrô sem internet. Sem conta obrigatória para começar e sem anúncios interrompendo sua partida.',
    },
  ],
  worldsKicker: '03 · CINCO CAMADAS INVADIDAS',
  worldsTitle: 'Mundos que você atravessa.',
  worldsIntro: 'Recortes reais das corridas em cada camada e o Tirano que sustenta o ninho principal.',
  bossPrefix: 'Tirano:',
  storyKicker: '04 · A HISTÓRIA DA DOBRA',
  downloadKicker: 'FICHA DE INSTALAÇÃO · ANDROID',
  downloadStatus: 'Lançamento em preparação na Google Play Store',
  downloadReqs: [
    { label: 'Sistema', val: 'Android 8.0 ou mais novo' },
    { label: 'Preço', val: 'Grátis (anúncios opcionais)' },
    { label: 'Conta', val: 'Opcional (joga sem cadastro)' },
    { label: 'Modo offline', val: 'Corridas e progresso locais' },
  ],
} : {
  dirLabel: {
    a: 'Direction A · Tactical Noir & Gameplay First',
    b: 'Direction B · Folded-Paper Editorial (#1594)',
    c: 'Direction C · Immersive Atlas & Mobile Bar',
  }[dir],
  specs: [
    { label: 'Platform', val: 'Android 8.0+' },
    { label: 'Controls', val: 'One thumb (move & shoot)' },
    { label: 'Connection', val: 'Plays 100% offline' },
    { label: 'Model', val: 'Free · No forced ads' },
  ],
  heroKicker: 'ANDROID ACTION · ONE THUMB · OFFLINE',
  shotsKicker: '01 · STRAIGHT FROM THE DEVICE',
  shotsTitle: 'See the run before you install.',
  shotsIntro: 'Real 9:16 screenshots with in-game HUD. Swipe across worlds and the Equipment screen.',
  pillarsKicker: '02 · HOW A RUN WORKS',
  pillarsTitle: 'Three clear rules. Zero clutter.',
  pillarsIntro: 'Built for quick mobile sessions without endless tutorials or pop-up store offers.',
  pillars: [
    {
      num: '01 / COMBAT',
      title: 'Move to dodge. Stop to shoot.',
      text: 'Built for one thumb: drag to weave through incoming fire, release to plant your feet and fire at your locked target.',
    },
    {
      num: '02 / LOADOUT',
      title: 'Every run, a new build.',
      text: 'Swap bows, blades and staves, equip world armor sets, and socket carved Seal shards as runes that reshape how you fight.',
    },
    {
      num: '03 / PROGRESS',
      title: 'On your device, at your pace.',
      text: 'Play on a plane or subway with no connection. No mandatory sign-up to start and zero forced ads breaking your run.',
    },
  ],
  worldsKicker: '03 · FIVE INVADED LAYERS',
  worldsTitle: 'Worlds you ride across.',
  worldsIntro: 'Real in-game arena cuts from each layer alongside the Tyrant holding the main nest.',
  bossPrefix: 'Tyrant:',
  storyKicker: '04 · LORE OF THE FOLD',
  downloadKicker: 'INSTALLATION LISTING · ANDROID',
  downloadStatus: 'Google Play Store launch in preparation',
  downloadReqs: [
    { label: 'System', val: 'Android 8.0 or newer' },
    { label: 'Price', val: 'Free (optional rewarded ads)' },
    { label: 'Account', val: 'Optional (play without sign-up)' },
    { label: 'Offline mode', val: 'Local runs and progress' },
  ],
};
---
<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{copy.dirLabel} · Dimension Riders</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body class={`p1595 dir-${dir}`}>
    <div class="proto-switcher" role="region" aria-label="Navegação do protótipo #1595">
      <div class="proto-switcher-inner">
        <span><strong>#1595 Protótipo</strong> · {copy.dirLabel}</span>
        <div class="proto-switcher-links">
          <a href={`${base}/comparacao/`}>← Comparação Antes × Propostas</a>
          <a href={protoHref('a', locale, view)} aria-current={dir === 'a' ? 'true' : undefined}>Direção A</a>
          <a href={protoHref('b', locale, view)} aria-current={dir === 'b' ? 'true' : undefined}>Direção B</a>
          <a href={protoHref('c', locale, view)} aria-current={dir === 'c' ? 'true' : undefined}>Direção C</a>
          <a href={protoHref(dir, locale, 'home')} aria-current={view === 'home' ? 'true' : undefined}>Início</a>
          <a href={protoHref(dir, locale, 'download')} aria-current={view === 'download' ? 'true' : undefined}>Baixar</a>
          <a href={protoHref(dir, locale, 'support')} aria-current={view === 'support' ? 'true' : undefined}>Suporte</a>
          <a href={protoHref(dir, otherLocale, view)}>{otherLocale.toUpperCase()}</a>
        </div>
      </div>
    </div>

    <header class="p-header">
      <div class="p-wrap p-header-inner">
        <a class="p-brand" href={protoHref(dir, locale, 'home')}>
          <img src={seal} width="28" height="32" alt="" />
          <span>Dimension Riders</span>
        </a>
        <nav class="p-nav" aria-label={t(locale, 'nav.label')}>
          <a href={protoHref(dir, locale, 'home')} aria-current={view === 'home' ? 'page' : undefined}>{t(locale, 'nav.home')}</a>
          <a href={`${base}/${locale}/${locale === 'pt' ? 'dobra' : 'fold'}/`}>{t(locale, 'nav.fold')}</a>
          <a class="p-nav-cta" href={protoHref(dir, locale, 'download')} aria-current={view === 'download' ? 'page' : undefined}>{t(locale, 'nav.download')}</a>
          <a class="p-lang" href={protoHref(dir, otherLocale, view)} aria-label={t(locale, 'nav.switchLabel')}>{otherLocale.toUpperCase()}</a>
        </nav>
      </div>
    </header>

    <main id="main">
      {view === 'home' && (
        <>
          {dir === 'a' && (
            <section class="p-hero">
              <Picture class="p-hero-bg" src={hero} alt="" formats={['avif']} fallbackFormat="webp" widths={[960, 1600, 2560]} sizes="100vw" loading="eager" fetchpriority="high" />
              <div class="p-wrap p-hero-inner">
                <div class="p-hero-copy">
                  <p class="p-kicker">{copy.heroKicker}</p>
                  <h1>{t(locale, 'hero.tagline')}<br /><span>{t(locale, 'hero.call')}</span></h1>
                  <p class="p-hero-lead">{t(locale, 'hero.opening')}</p>
                  <div class="p-actions">
                    <a class="p-btn" href={protoHref(dir, locale, 'download')}>
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.5 3.6v16.8c0 .8.9 1.3 1.6.8l13.4-8.4c.6-.4.6-1.3 0-1.7L6.1 2.8c-.7-.5-1.6 0-1.6.8z"/></svg>
                      {t(locale, 'buttons.android')}
                    </a>
                    <a class="p-btn-ghost" href="#gameplay">{locale === 'pt' ? 'Ver corrida real ↓' : 'See real gameplay ↓'}</a>
                  </div>
                </div>
              </div>
            </section>
          )}

          {dir === 'b' && (
            <section class="p-hero">
              <div class="p-wrap">
                <div class="p-hero-sheet">
                  <div class="p-hero-copy">
                    <p class="p-kicker">{copy.heroKicker}</p>
                    <h1>{t(locale, 'hero.tagline')}<br /><span>{t(locale, 'hero.call')}</span></h1>
                    <p class="p-hero-lead">{t(locale, 'hero.opening')}</p>
                    <div class="p-actions">
                      <a class="p-btn" href={protoHref(dir, locale, 'download')}>
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.5 3.6v16.8c0 .8.9 1.3 1.6.8l13.4-8.4c.6-.4.6-1.3 0-1.7L6.1 2.8c-.7-.5-1.6 0-1.6.8z"/></svg>
                        {t(locale, 'buttons.android')}
                      </a>
                      <a class="p-btn-ghost" href={`${base}/${locale}/${locale === 'pt' ? 'dobra' : 'fold'}/`}>{t(locale, 'hero.explore')} →</a>
                    </div>
                  </div>
                  <div class="p-hero-art-frame">
                    <Picture src={hero} alt={t(locale, 'hero.art')} formats={['avif']} fallbackFormat="webp" widths={[960, 1600]} sizes="(max-width: 900px) 95vw, 640px" loading="eager" fetchpriority="high" />
                    <span class="p-art-tag">{t(locale, 'hero.art')}</span>
                  </div>
                </div>
              </div>
            </section>
          )}

          {dir === 'c' && (
            <section class="p-hero">
              <Picture class="p-hero-bg" src={hero} alt="" formats={['avif']} fallbackFormat="webp" widths={[960, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
              <div class="p-wrap p-hero-split">
                <div class="p-hero-copy">
                  <p class="p-kicker">{copy.heroKicker}</p>
                  <h1>{t(locale, 'hero.tagline')}<br /><span>{t(locale, 'hero.call')}</span></h1>
                  <p class="p-hero-lead">{t(locale, 'hero.opening')}</p>
                  <div class="p-actions">
                    <a class="p-btn" href={protoHref(dir, locale, 'download')}>
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.5 3.6v16.8c0 .8.9 1.3 1.6.8l13.4-8.4c.6-.4.6-1.3 0-1.7L6.1 2.8c-.7-.5-1.6 0-1.6.8z"/></svg>
                      {t(locale, 'buttons.android')}
                    </a>
                    <a class="p-btn-ghost" href={`${base}/${locale}/${locale === 'pt' ? 'dobra' : 'fold'}/`}>{t(locale, 'hero.explore')} →</a>
                  </div>
                </div>
                <div class="p-hero-phones">
                  <div class="p-phone-card">
                    <Image src={shots.lava} alt={t(locale, 'gallery.lavaAlt')} widths={[280, 560]} sizes="260px" loading="eager" />
                    <span>{t(locale, 'gallery.lava')}</span>
                  </div>
                  <div class="p-phone-card">
                    <Image src={shots.arsenal} alt={t(locale, 'gallery.arsenalAlt')} widths={[280, 560]} sizes="260px" loading="eager" />
                    <span>{t(locale, 'gallery.arsenal')}</span>
                  </div>
                </div>
              </div>
            </section>
          )}

          {/* Barra técnica objetiva logo abaixo do Hero */}
          <div class="p-specs-bar" role="region" aria-label={t(locale, 'features.label')}>
            {copy.specs.map((s) => (
              <div class="p-spec-item">
                <span class="p-spec-label">{s.label}</span>
                <span class="p-spec-val">{s.val}</span>
              </div>
            ))}
          </div>

          {/* SEÇÃO 1: Capturas reais do jogo na primeira dobra de rolagem (antes ficava em y=2221px!) */}
          <section class="p-section" id="gameplay" aria-labelledby="shots-title">
            <div class="p-wrap">
              <p class="p-kicker">{copy.shotsKicker}</p>
              <div class="p-sec-head">
                <h2 id="shots-title">{copy.shotsTitle}</h2>
                <p>{copy.shotsIntro}</p>
              </div>
              <div class="p-shots-grid">
                {shotKeys.map((key, idx) => (
                  <figure class="p-shot-card">
                    <a href={shots[key].src} aria-label={t(locale, 'gallery.enlarge', { name: t(locale, `gallery.${key}`) })}>
                      <Image src={shots[key]} alt={t(locale, `gallery.${key}Alt`)} widths={[280, 560]} sizes="(max-width: 600px) 72vw, 270px" loading="eager" />
                    </a>
                    <figcaption class="p-shot-meta">
                      <span class="p-shot-title">{t(locale, `gallery.${key}`)}</span>
                      <span class="p-shot-num">0{idx + 1}/04</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          </section>

          {/* SEÇÃO 2: Mecânica concreta em 3 pilares editoriais */}
          <section class="p-section alt" aria-labelledby="pillars-title">
            <div class="p-wrap">
              <p class="p-kicker">{copy.pillarsKicker}</p>
              <div class="p-sec-head">
                <h2 id="pillars-title">{copy.pillarsTitle}</h2>
                <p>{copy.pillarsIntro}</p>
              </div>
              <div class="p-pillars">
                {copy.pillars.map((p) => (
                  <div class="p-pillar">
                    <span class="p-pillar-num">{p.num}</span>
                    <h3>{p.title}</h3>
                    <p>{p.text}</p>
                  </div>
                ))}
              </div>
            </div>
          </section>

          {/* SEÇÃO 3: As 5 Camadas reais + Tiranos (sem T-pose em fundo cinza!) */}
          <section class="p-section" aria-labelledby="worlds-title">
            <div class="p-wrap">
              <p class="p-kicker">{copy.worldsKicker}</p>
              <div class="p-sec-head">
                <h2 id="worlds-title">{copy.worldsTitle}</h2>
                <p>{copy.worldsIntro}</p>
              </div>
              <div class="p-worlds-grid">
                {WORLDS.map(({ key, image }, i) => {
                  const tyrant = TYRANTS.find((ty) => ty.key === key)!;
                  return (
                    <article class="p-world-card">
                      <div class="p-world-img">
                        <Image src={image} alt={t(locale, `fold.worlds.${key}.alt`)} widths={[300, 450]} sizes="(max-width: 600px) 78vw, 220px" loading="eager" />
                      </div>
                      <div class="p-world-body">
                        <span class="p-world-layer">{t(locale, 'fold.worlds.layer', { n: String(i + 1) })}</span>
                        <h3>{t(locale, `fold.worlds.${key}.name`)}</h3>
                        <p>{t(locale, `fold.worlds.${key}.line`)}</p>
                        <div class="p-world-boss">
                          {copy.bossPrefix} <strong>{t(locale, `fold.cast.${key}.name`)}</strong>
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            </div>
          </section>

          {/* SEÇÃO 4: Chamada editorial para A Dobra com pintura real (em vez de repetir o Selo SVG gigante) */}
          <section class="p-section alt">
            <div class="p-wrap">
              <div class="p-story-banner">
                <div class="p-story-copy">
                  <p class="p-kicker">{copy.storyKicker}</p>
                  <h2>{t(locale, 'story.title')}</h2>
                  <p>{t(locale, 'story.text')}</p>
                  <div>
                    <a class="p-btn-ghost" href={`${base}/${locale}/${locale === 'pt' ? 'dobra' : 'fold'}/`}>{t(locale, 'story.link')} →</a>
                  </div>
                </div>
                <div class="p-story-art">
                  <Image src={threeRifts} alt={t(locale, 'fold.figures.threeRifts')} widths={[480, 760]} sizes="(max-width: 900px) 95vw, 520px" loading="eager" />
                </div>
              </div>
            </div>
          </section>
        </>
      )}

      {view === 'download' && (
        <section class="p-download-section">
          <div class="p-wrap">
            <div class="p-download-card">
              <div class="p-download-media">
                {/* Usa duel.webp sem o logo gravado que era cortado ao meio em "ENSION / ERS"! */}
                <Image src={duel} alt={t(locale, 'download.artAlt')} widths={[640, 1024]} sizes="(max-width: 900px) 95vw, 600px" loading="eager" />
              </div>
              <div class="p-download-body">
                <p class="p-kicker">{copy.downloadKicker}</p>
                <div class="p-app-header">
                  <Image src={icon} alt="Dimension Riders" width={68} loading="eager" />
                  <div>
                    <h1>Dimension Riders</h1>
                    <p>{t(locale, 'download.intro')}</p>
                  </div>
                </div>
                <div class="p-store-box">
                  <div class="p-store-status">{copy.downloadStatus}</div>
                  <p>{t(locale, 'download.storeSoon')}</p>
                </div>
                <ul class="p-req-list">
                  {copy.downloadReqs.map((r) => (
                    <li><strong>{r.label}</strong>{r.val}</li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </section>
      )}

      {view === 'support' && (
        <div class="p-doc-wrap">
          <div class="p-doc-sheet">
            <p class="p-kicker">DIMENSION RIDERS · {t(locale, 'support.title').toUpperCase()}</p>
            <h1>{t(locale, 'support.title')}</h1>
            <p class="p-doc-lead">{t(locale, 'support.intro')}</p>
            <article class="p-doc-prose">
              <SupportContent />
            </article>
          </div>
        </div>
      )}
    </main>

    {dir === 'c' && view === 'home' && (
      <div class="p-sticky-mobile-bar" role="region" aria-label="Atalho de instalação">
        <div class="p-sticky-info">
          <Image src={icon} alt="" width={36} loading="eager" />
          <div>
            <strong>Dimension Riders</strong>
            <span>{locale === 'pt' ? 'Grátis · Offline · Android' : 'Free · Offline · Android'}</span>
          </div>
        </div>
        <a class="p-sticky-cta" href={protoHref(dir, locale, 'download')}>{t(locale, 'nav.download')}</a>
      </div>
    )}

    <footer class="p-footer">
      <div class="p-wrap p-footer-inner">
        <span>{t(locale, 'footer.madeBy')}</span>
        <div class="p-footer-links">
          <a href={protoHref(dir, locale, 'support')}>{t(locale, 'nav.support')}</a>
          <a href={`${base}/${locale}/${locale === 'pt' ? 'termos' : 'terms'}/`}>{t(locale, 'nav.terms')}</a>
          <a href={`${base}/${locale}/${locale === 'pt' ? 'privacidade' : 'privacy'}/`}>{t(locale, 'nav.privacy')}</a>
          <a href={`mailto:${CONTACT_EMAIL}`}>{t(locale, 'footer.contact')}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
