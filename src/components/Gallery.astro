---
import { Image } from 'astro:assets';
import { shotsFor } from '../images/shots';
import { t, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const shots = shotsFor(locale);
const keys = ['forest', 'gear', 'lava', 'arsenal'] as const;
---
<div class="gallery-band">
  <section class="content wrap gallery" aria-labelledby="gallery-title">
    <div class="eyebrow">{t(locale, 'gallery.eyebrow')}</div>
    <div class="section-top"><h2 id="gallery-title">{t(locale, 'gallery.title')}</h2><p>{t(locale, 'gallery.intro')}</p></div>
    <div class="gallery-track">
      {keys.map((key) => (
        <figure class="shot">
          <a href={shots[key].src} aria-label={t(locale, 'gallery.enlarge', { name: t(locale, `gallery.${key}`) })}>
            <Image src={shots[key]} alt={t(locale, `gallery.${key}Alt`)} widths={[180, 280, 560]} sizes="(max-width: 600px) 45vw, 270px" loading="lazy" />
          </a>
          <figcaption>{t(locale, `gallery.${key}`)}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</div>
