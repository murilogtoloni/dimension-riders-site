---
import { Image } from 'astro:assets';
import { shots } from '../images/shots';
import { t, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="gallery">
  <h2>{t(locale, 'gallery.title')}</h2>
  {shots.length === 0 ? (
    <p class="gallery-empty">{t(locale, 'gallery.empty')}</p>
  ) : (
    <div class="gallery-track">
      {shots.map((shot, i) => (
        <Image src={shot} alt={t(locale, 'gallery.alt', { n: String(i + 1) })} width={360} loading="lazy" />
      ))}
    </div>
  )}
</section>
