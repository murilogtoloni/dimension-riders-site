---
import { Picture } from 'astro:assets';
import hero from '../images/hero.webp';
import { PLAY_STORE_URL } from '../config';
import { localePath, t, type Locale } from '../i18n';
import DownloadLink from './DownloadLink.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="hero">
  <Picture class="hero-bg" src={hero} alt="" formats={['avif']} fallbackFormat="webp" widths={[960, 1600, 2560]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <div class="eyebrow">{t(locale, 'hero.eyebrow')}</div>
      <h1>{t(locale, 'hero.tagline')}<br /><strong>{t(locale, 'hero.call')}</strong></h1>
      <p>{t(locale, 'hero.opening')}</p>
      <div class="buttons">
        <DownloadLink locale={locale} />
        <a class="text-link" href={localePath(locale, 'fold')}>{t(locale, 'hero.explore')} <span aria-hidden="true">→</span></a>
      </div>
      <p class="facts">{PLAY_STORE_URL ? t(locale, 'hero.available') : t(locale, 'hero.soon')}</p>
    </div>
  </div>
  <span class="art-credit">{t(locale, 'hero.art')}</span>
</section>
