---
import { Image } from 'astro:assets';
import feature from '../images/feature.png';
import { t, type Locale } from '../i18n';
import StoreButtons from './StoreButtons.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<section class="hero">
  <Image class="hero-bg" src={feature} alt="" widths={[640, 1024]} sizes="100vw" loading="eager" />
  <div class="hero-content">
    <h1>{t(locale, 'site.name')}</h1>
    <p class="tagline">{t(locale, 'hero.tagline')}</p>
    <p class="opening">{t(locale, 'hero.opening')}</p>
    <StoreButtons locale={locale} />
  </div>
</section>
