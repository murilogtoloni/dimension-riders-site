---
import { Image } from 'astro:assets';
import { APK_URL, APP_VERSION, PLAY_STORE_URL } from '../config';
import enBadge from '../images/badges/en-google-play.png';
import ptBadge from '../images/badges/pt-google-play.png';
import { t, type Locale } from '../i18n';
import DownloadIcon from './DownloadIcon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const hasStore = PLAY_STORE_URL !== '';
const hasApk = APK_URL !== '';
---
<div class="store-buttons">
  {hasStore ? (
    <a class="play-badge" href={PLAY_STORE_URL}>
      <Image src={locale === 'pt' ? ptBadge : enBadge} alt={t(locale, 'buttons.playStore')} width={220} format="png" loading="eager" />
    </a>
  ) : (
    <button class="store-disabled" disabled>
      <DownloadIcon /><span>{t(locale, 'buttons.androidPlatform')}<small>{t(locale, 'download.soon')}</small></span>
    </button>
  )}
  {hasApk && <a class={`button ${hasStore ? 'secondary' : ''}`} href={APK_URL}><DownloadIcon />{t(locale, 'buttons.apk')}</a>}
  {hasApk && <small>{t(locale, 'buttons.apkVersion', { version: APP_VERSION })}</small>}
</div>
