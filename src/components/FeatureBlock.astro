---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { title: string; text: string; image?: ImageMetadata }
const { title, text, image } = Astro.props;
---
<article class="feature">
  {image ? <Image src={image} alt="" width={480} loading="lazy" /> : <div class="feature-placeholder" aria-hidden="true"></div>}
  <h3>{title}</h3>
  <p>{text}</p>
</article>
